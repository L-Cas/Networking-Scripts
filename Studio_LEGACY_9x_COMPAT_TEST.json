{
  "title": "Legacy Dashboard Studio Dropdown Test",
  "description": "Compatibility test using Splunk 9.0/9.1-style layout and a literal datasource.",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      },
      "title": "Global Time Range"
    },
    "input_noc": {
      "options": {
        "items": ">frame(label, value) | prepend(formattedStatics) | objects()",
        "token": "noc"
      },
      "title": "NOC / Main Location",
      "type": "input.dropdown",
      "dataSources": {
        "primary": "ds_noc_lookup"
      },
      "context": {
        "formattedConfig": {
          "number": {
            "prefix": ""
          }
        },
        "formattedStatics": ">statics | formatByType(formattedConfig)",
        "statics": [],
        "label": ">primary | seriesByName(\"noc_label\") | renameSeries(\"label\") | formatByType(formattedConfig)",
        "value": ">primary | seriesByName(\"noc_id\") | renameSeries(\"value\") | formatByType(formattedConfig)"
      }
    }
  },
  "dataSources": {
    "ds_noc_lookup": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults\n| eval noc_label=\"Syracuse, NY\", noc_id=\"SYR\"\n| table noc_label noc_id",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      },
      "name": "Literal NOC Search"
    },
    "ds_lookup_table": {
      "type": "ds.search",
      "options": {
        "query": "| inputlookup NOC_Site_Lookup.csv\n| table noc_id noc_label location_id scope_label scope_value scope_sort record_type status",
        "queryParameters": {
          "earliest": "0",
          "latest": "now"
        }
      },
      "name": "Lookup Table Test"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
    }
  },
  "visualizations": {
    "viz_lookup_table": {
      "type": "splunk.table",
      "title": "Lookup Table Test",
      "dataSources": {
        "primary": "ds_lookup_table"
      },
      "options": {}
    }
  },
  "layout": {
    "type": "grid",
    "options": {},
    "structure": [
      {
        "item": "viz_lookup_table",
        "type": "block",
        "position": {
          "x": 0,
          "y": 0,
          "w": 1200,
          "h": 400
        }
      }
    ],
    "globalInputs": [
      "input_global_trp",
      "input_noc"
    ]
  }
}